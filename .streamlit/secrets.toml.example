# Streamlit Community Cloud -> your app -> Settings -> Secrets. Paste these lines (with real values).
# Never commit a real secrets.toml (it is in .gitignore).
GEMINI_API_KEY = "your-free-key-from-aistudio.google.com/apikey"
HR_LLM_PROVIDER = "gemini"
HR_GEMINI_MODEL = "gemini-3.5-flash-lite"
HR_GEMINI_FALLBACK_MODELS = "gemini-3.1-flash-lite,gemini-3.6-flash"
DEMO_PASSCODE = ""            # optional: set one to stop strangers using up your free quota
RATE_LIMIT_PER_MINUTE = "6"
SESSION_TOKEN_BUDGET = "250000"
DAILY_TOKEN_BUDGET = "2000000"
REPO_URL = "https://github.com/MuhammadHasaanWahid/hr-copilot"

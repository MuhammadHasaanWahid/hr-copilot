# Copy to `.env` (never commit it - it is in .gitignore) and fill in what you need.
# On Streamlit Community Cloud put the same keys in the app's Secrets instead.

# --- AI model -----------------------------------------------------------------
# Without a key the assistant runs the deterministic OFFLINE planner (same tools, same governance).
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
HR_LLM_PROVIDER=gemini           # gemini (free tier, default) | anthropic | bedrock (enterprise paths)
HR_LLM_MODE=auto                 # auto | llm | offline   (auto = use the LLM if a key is present)
HR_GEMINI_MODEL=gemini-3.5-flash-lite
HR_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash   # tried when a model is out of free quota
# Optional paid / enterprise providers:
# ANTHROPIC_API_KEY=
# HR_CLAUDE_MODEL=claude-opus-5-5
# HR_EFFORT=medium
# AWS_REGION=eu-west-1           # HR_LLM_PROVIDER=bedrock uses your AWS credentials
# HR_PRICE_IN=0                  # USD per million tokens for the cost dashboard (defaults: gemini 0, claude 4/20)
# HR_PRICE_OUT=0

# --- Governance ---------------------------------------------------------------
# advisory   -> the assistant may only read and recommend; every write is blocked
# assisted   -> self-service writes need the requester's one-click confirmation (default)
# autonomous -> self-service writes execute directly
# High-risk writes ALWAYS need an authorised human approver who is not the requester.
HR_AUTONOMY=assisted

# --- App ----------------------------------------------------------------------
APP_ENV=demo                     # demo | prod  (prod disables demo login and data reset, requires JWT_SECRET)
JWT_SECRET=                      # required in prod; a random per-process secret is used in demo
DEMO_PASSCODE=                   # optional: require a passcode to sign in to the public demo
HR_DB_PATH=data/hr_copilot.db    # SQLite file for the API server (the Streamlit live demo uses a per-visitor in-memory sandbox)
CORS_ORIGINS=http://localhost:8501
REPO_URL=                        # shown in the Streamlit sidebar
# API_URL=http://localhost:8000  # Streamlit: call a separately deployed FastAPI backend instead of in-process

# --- Abuse / cost controls ----------------------------------------------------
RATE_LIMIT_PER_MINUTE=12
SESSION_TOKEN_BUDGET=300000
DAILY_TOKEN_BUDGET=3000000

# Pin "today" for reproducible demos/tests (ISO date). Defaults to the real date.
HR_DEMO_TODAY=
